{
  "expo": {
    "name": "NEXUS Website",
    "slug": "nexus-website",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-dark.png",
    "scheme": "nexus-website",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#111827",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#111827"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
